# "Login with GitHub" for the GitHub vault. These are public (not secrets), so
# they're committed here and used by the production build automatically — no CI
# config needed. Forks: change these to your own GitHub App + Worker.
# For local dev, override in .env.local (gitignored). See oauth-proxy/README.md.

VITE_GITHUB_APP_SLUG=inputpub
VITE_GITHUB_OAUTH_WORKER=https://oauth.inputpub.com
