# "Login with GitHub" for the GitHub vault. These are public (not secrets).
#
# Production values live in the committed .env.production and are used by the
# build automatically. This file is just a reference.
#
# For local dev, copy to .env.local (gitignored) and point at your local Worker
# and a dev GitHub App (with an http://localhost:5173/callback.html callback).
# See oauth-proxy/README.md.

# The GitHub App's slug (the name in its URL: github.com/apps/<slug>).
VITE_GITHUB_APP_SLUG=
# The token-exchange Worker's URL.
VITE_GITHUB_OAUTH_WORKER=
